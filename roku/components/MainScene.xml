<?xml version="1.0" encoding="utf-8"?>
<!-- One Scene hosts every screen; each screen lives in its own script file and mirrors web/js/<screen>.js. -->
<component name="MainScene" extends="Scene">
  <interface>
    <field id="exitApp" type="boolean" value="false" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/Home.brs" />
  <script type="text/brightscript" uri="pkg:/components/Recipe.brs" />
  <script type="text/brightscript" uri="pkg:/components/Cook.brs" />
  <script type="text/brightscript" uri="pkg:/components/Menu.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Group id="root" />
  </children>
</component>
